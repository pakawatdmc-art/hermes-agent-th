#!/usr/bin/env bash
# Workspace-local entry point; Hermes PM owns the runtime and dependencies.
set -e

repo_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$repo_dir"
umask 077
export HERMES_HOME="$repo_dir/.hermes-dev"
export HERMES_RUNTIME_DIR="$HERMES_HOME/tools"
export UV_PYTHON_INSTALL_DIR="$HERMES_HOME/bootstrap-python"
# The upstream archive guard scans the checkout; package caches contain .tar.gz files.
export UV_CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/hermes-dev/uv"
export PATH="$repo_dir/.local-tools/bin:$PATH"
mkdir -p "$HERMES_HOME"
# PM's source-backend probe uses its home-scoped cache instead of UV_CACHE_DIR.
# Keep both caches outside the tree checked by the upstream archive guard.
pm_cache_dir="${XDG_CACHE_HOME:-$HOME/.cache}/hermes-dev/pm-uv"
mkdir -p "$pm_cache_dir" "$HERMES_HOME/cache"
if [[ ! -e "$HERMES_HOME/cache/uv" && ! -L "$HERMES_HOME/cache/uv" ]]; then
    ln -s "$pm_cache_dir" "$HERMES_HOME/cache/uv"
fi

case "${1:-help}" in
    help|--help|-h)
        cat <<'HELP'
วิธีใช้: ./dev COMMAND [ARGS...]
  setup          เตรียมหรืออัปเดตเครื่องมือ และตั้งค่าไทยสำหรับการติดตั้งใหม่
  shell          เปิด Bash ที่พร้อมพัฒนา (พิมพ์ exit เพื่อออก)
  hermes ...     เรียก Hermes CLI จากซอร์สชุดนี้
  terminal       เปิดหน้าจอ Terminal ภาษาไทย
  desktop        เปิด Desktop ภาษาไทยที่ build แล้ว
  desktop-build  build Desktop จากซอร์สชุดนี้
  doctor         ตรวจการตั้งค่าและสภาพแวดล้อม
  check ...      ตรวจโค้ดตามข้อกำหนดของต้นทาง
  test ...       ทดสอบด้วย runner ของต้นทาง (ค่าเริ่มต้น 2 workers)
  COMMAND ...    รันคำสั่งใน environment ของ PM เช่น python หรือ npm

การตั้งค่า บัญชี และประวัติส่วนตัวอยู่ใน .hermes-dev/ ซึ่งไม่เข้า Git
HELP
        ;;
    setup)
        shift
        printf 'กำลังเตรียมสภาพแวดล้อม Hermes ภาษาไทย ครั้งแรกอาจใช้เวลาหลายนาที…\n'
        bash ./setup-hermes.sh --runtime-only "$@"
        exec ./scripts/run-in-hermes-env python -m hermes_cli.thai_defaults
        ;;
    shell)
        exec bash --rcfile "$repo_dir/local-dev/bashrc" -i
        ;;
    hermes)
        shift
        exec ./scripts/run-in-hermes-env python ./hermes "$@"
        ;;
    terminal)
        shift
        exec ./scripts/run-in-hermes-env python ./hermes chat --tui "$@"
        ;;
    desktop)
        shift
        export HERMES_DESKTOP_USER_DATA_DIR="$HERMES_HOME/desktop"
        export HERMES_DESKTOP_ISOLATED_BACKEND=1
        export HERMES_DESKTOP_SKIP_PROTOCOL_REGISTRATION=1
        # PM owns this checkout's runtime; never discover another installed copy.
        export HERMES_DESKTOP_HERMES="$repo_dir/.hermes/bin/hermes"
        exec ./scripts/run-in-hermes-env python ./hermes desktop --source --skip-build \
            --hermes-root "$repo_dir" --cwd "$repo_dir" "$@"
        ;;
    desktop-build)
        shift
        ./scripts/run-in-hermes-env node scripts/build/electron-runtime.mjs --source "$repo_dir"
        exec ./scripts/run-in-hermes-env npm run build --workspace apps/desktop "$@"
        ;;
    doctor)
        shift
        exec ./scripts/run-in-hermes-env python ./hermes doctor "$@"
        ;;
    check)
        shift
        # Lint tooling belongs to PM's test interpreter, not the application runtime.
        exec ./scripts/run-in-hermes-env bash -c \
            'unset PYTHONPATH; exec "$__HERMES_TEST_PYTHON" ./scripts/check "$@"' \
            hermes-check "$@"
        ;;
    test)
        shift
        exec ./scripts/run_tests.sh -j 2 "$@"
        ;;
    *)
        exec ./scripts/run-in-hermes-env "$@"
        ;;
esac
